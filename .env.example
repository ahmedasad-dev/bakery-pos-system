# Application
APP_ENV=development
DJANGO_SECRET_KEY=replace-this-with-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000

# PostgreSQL
POSTGRES_DB=bakery_pos
POSTGRES_USER=bakery_pos
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bakery_pos:change-me@db:5432/bakery_pos

# JWT cookies
JWT_REFRESH_COOKIE_NAME=bakery_refresh
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax

# Frontend server-side proxy target
BACKEND_INTERNAL_URL=http://backend:8000

